{
  "name": "wcr-projects-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive Gurugram map of White Collar Realty projects, built from whitecollarrealty.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "scrape": "tsx scripts/scrape-projects.ts",
    "geocode": "tsx scripts/geocode.ts",
    "pins:osm": "tsx scripts/geocode-projects.ts",
    "pins:import": "tsx scripts/import-pins.ts",
    "sectors:audit": "tsx scripts/audit-sectors.ts",
    "areas:report": "tsx scripts/area-lookup-report.ts",
    "nearby:fetch": "tsx scripts/fetch-nearby.ts",
    "nearby:compute": "tsx scripts/compute-nearby.ts",
    "data:update": "npm run scrape && npm run pins:osm -- --apply && npm run geocode && npm run nearby:fetch && npm run nearby:compute",
    "verify": "tsx scripts/verify.ts",
    "check:app": "tsx scripts/check-app.ts",
    "test": "tsx --test tests/parse.test.ts tests/pinmatch.test.ts tests/pinimport.test.ts tests/locality.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
